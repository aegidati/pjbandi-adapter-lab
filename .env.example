# LLM provider settings (optional, for AI enrichment)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# HTTP settings
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
# Keep true in normal usage. Set false only for local debugging in trusted networks.
HTTP_VERIFY_SSL=true
# Optional path to a CA bundle (PEM) for corporate/self-signed TLS interception.
# HTTP_CA_BUNDLE=C:/path/to/corporate-root-ca.pem
USER_AGENT=AdapterLab/0.1 (+https://github.com/aegidati/pjbandi-adapter-lab)

# Storage paths (defaults shown)
DATA_DIR=data
RAW_DIR=data/raw
EXTRACTED_DIR=data/extracted
PROFILES_DIR=data/profiles
FIXTURES_DIR=data/fixtures
REPORTS_DIR=data/reports

# Logging
LOG_LEVEL=INFO
